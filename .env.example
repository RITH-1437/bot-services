# ------------------------------------------------------------------------------
# Copy this file to .env and fill in the values. NEVER commit .env.
#   cp .env.example .env     (Windows PowerShell: Copy-Item .env.example .env)
# ------------------------------------------------------------------------------

# REQUIRED. Token from @BotFather -> /mybots -> your bot -> API Token.
# Keep it secret: never paste it into GitHub, logs, screenshots or the README.
TELEGRAM_BOT_TOKEN=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# polling = long polling (recommended for a VPS / Docker / Railway worker)
# webhook = Telegram pushes updates to your public HTTPS URL (Run mode=polling|webhook)
RUN_MODE=polling

# Render the template and log it, but never send anything to Telegram.
# Useful for checking the message locally. Default: false
DRY_RUN=false

# ------------------------------------------------------------------------------
# WELCOME MESSAGE
# ------------------------------------------------------------------------------
# Placeholders:
#   {{mention}}       @username when available, otherwise a clickable mention
#   {{name}}          first + last name
#   {{username}}      @username, empty when the member has none
#   {{group}}         group title
#   {{groupUsername}} @groupusername when the group has a public username
# Use \n for line breaks (this file must stay on one line per variable).
WELCOME_TEMPLATE="👋 Welcome {{mention}} to 2Brothers Services! 🚀\n\nWe're happy to have you here!\n\n💻 Web • Systems • Data • Cloud\n\n🌐 https://2brothers-services.vercel.app/\n\nFeel free to introduce yourself and enjoy the community! 🤝"

# HTML enables clickable mentions for members without a username.
# Use "none" for a plain-text message (no clickable mentions).
WELCOME_PARSE_MODE=HTML

# true  = welcome humans only
# false = welcome bots too
IGNORE_BOTS=true

# Delete the welcome message after this delay: 30s, 10m, 1h, 2d, or "never".
# Deleting requires the "Delete Messages" permission for the bot.
# Note: pending deletions are lost if the process restarts (the bot is stateless).
WELCOME_DELETE_AFTER=1h

# Ignore a repeat join of the same user inside this window (anti-duplicate).
WELCOME_DUPLICATE_WINDOW=10m

# How often a failed send is retried (rate limits / network errors).
MAX_RETRIES=3

# Restrict the bot to specific chats. Leave EMPTY to welcome in every group
# the bot is a member of. Supergroup ids look like -1001234567890.
ALLOWED_CHAT_IDS=

# Used by the /about command.
SITE_URL=https://2brothers-services.vercel.app/

# ------------------------------------------------------------------------------
# WEBHOOK MODE ONLY (ignored when RUN_MODE=polling)
# ------------------------------------------------------------------------------
# Public HTTPS base URL of this service, e.g. https://bot.example.com
WEBHOOK_DOMAIN=
# Shared secret Telegram sends back in the x-telegram-bot-api-secret-token header.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=
PORT=3000
WEBHOOK_PATH=/webhook
# Health endpoint for your hosting platform: GET /health -> {"status":"ok"}
HEALTH_PATH=/health
